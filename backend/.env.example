NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bike_store

JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES_IN=2h

# Origenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate limiting (ventana en minutos / maximo de requests)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

ADMIN_NAME=Administrador Bike Store
ADMIN_EMAIL=admin@bikestore.co
ADMIN_PASSWORD=tuclavepersonal123