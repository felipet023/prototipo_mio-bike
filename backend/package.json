{
  "name": "bike-store-backend",
  "version": "1.0.0",
  "description": "Backend de Bike Store: autenticacion JWT, roles y gestion de productos, carrito y pedidos",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit tests/unit",
    "test:integration": "jest --runInBand --forceExit tests/integration"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.3"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
